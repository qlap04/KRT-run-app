<%- include('../partials/_header') %>
<h2>Audit log – <%= date %></h2>
<form method="get" class="inline"><label>Date <input type="date" name="date" value="<%= date %>"></label> <button>View</button></form>
<table>
  <tr><th>Time (UTC)</th><th>Action</th><th>Actor</th><th>Run</th><th>Km</th><th>Run date</th><th>Result</th><th>IP</th><th>Detail</th></tr>
  <% rows.forEach(function(r){ %>
  <tr><td><%= r.timestamp ? new Date(r.timestamp).toISOString().slice(11,19) : '' %></td>
    <td><%= r.action %></td><td><%= r.actor %></td><td><%= String(r.runId || '').slice(0, 8) %></td><td><%= r.km %></td>
    <td><%= r.runDate %></td><td><%= r.result %></td><td><%= r.clientIp %></td><td><%= r.detail %></td></tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="9">No records.</td></tr><% } %>
</table>
<%- include('../partials/_footer') %>
