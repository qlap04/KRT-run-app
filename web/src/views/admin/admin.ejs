<%- include('../partials/_header') %>
<h2>Review proofs – <%= month %></h2>
<form method="get" class="inline"><label>Month <input type="month" name="month" value="<%= month %>"></label> <button>View</button></form>
<table>
  <tr><th>Employee</th><th>Run date</th><th>Km</th><th>Proof</th><th>Decision</th></tr>
  <% list.forEach(function(r){ %>
  <tr>
    <td><%= r.fullName %> (<%= r.employeeCode %>)</td><td><%= r.runDate %></td><td><%= r.km %></td>
    <td><a href="/proof/<%= r.partitionKey %>/<%= r.rowKey %>" target="_blank"><img class="thumb" src="/proof/<%= r.partitionKey %>/<%= r.rowKey %>" alt="proof"></a></td>
    <td>
      <form method="post" class="inline" action="/admin/runs/<%= r.partitionKey %>/<%= r.rowKey %>/approve">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ok">Approve</button></form>
      <form method="post" class="inline" action="/admin/runs/<%= r.partitionKey %>/<%= r.rowKey %>/reject">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input name="note" placeholder="Reason"><button class="bad">Reject</button></form>
    </td>
  </tr>
  <% }) %>
  <% if (!list.length) { %><tr><td colspan="5">Nothing is waiting for review.</td></tr><% } %>
</table>
<%- include('../partials/_footer') %>
