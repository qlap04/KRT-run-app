<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KRT-run</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="top">
  <a class="brand" href="/">🏃 KRT-run</a>
  <% if (appEnv !== 'prod') { %><span class="env"><%= appEnv %></span><% } %>
  <% if (user) { %>
  <nav>
    <a href="/runs">My runs</a>
    <a href="/upload">Submit proof</a>
    <a href="/leaderboard">Leaderboard</a>
    <% if (user.role === 'admin') { %><a href="/admin">Review</a><a href="/admin/audit">Audit log</a><% } %>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="link"><%= user.fullName %> (<%= user.code %>) · Log out</button>
    </form>
  </nav>
  <% } %>
</header>
<main>
