<%- include('partials/_header') %>
<h2>Leaderboard – <%= month %></h2>
<form method="get" class="inline"><label>Month <input type="month" name="month" value="<%= month %>"></label> <button>View</button></form>
<table>
  <tr><th>#</th><th>Employee</th><th>Total km (approved)</th><th>Runs</th></tr>
  <% rows.forEach(function(r, i){ %>
  <tr><td><%= i + 1 %></td><td><%= r.fullName %> (<%= r.employeeCode %>)</td><td><%= r.km %></td><td><%= r.runs %></td></tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="4">No data yet.</td></tr><% } %>
</table>
<%- include('partials/_footer') %>
