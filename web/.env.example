# Copy to .env and load it (e.g. node --env-file=.env server.js). NEVER commit .env.
APP_ENV=dev
PORT=8080
# Local development: set a storage connection string (e.g. for a local storage emulator).
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# On Azure: leave STORAGE_CONNECTION_STRING empty and set STORAGE_ACCOUNT_NAME (managed identity is used).
STORAGE_ACCOUNT_NAME=
QUEUE_NAME=upload-jobs
BLOB_CONTAINER=proofs
TABLE_USERS=Users
TABLE_RUNS=Runs
TABLE_AUDIT=AuditLog
SESSION_SECRET=change-me-local-only
ADMIN_CODE=ADMIN01
API_KEY=
