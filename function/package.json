{
  "name": "krtrun-function",
  "version": "1.0.0",
  "description": "KRT-run - upload-jobs queue processor (Azure Functions Node v4)",
  "main": "src/functions/*.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "func start",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:unit:ci": "mkdir -p test-results && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/unit.xml \"tests/unit/**/*.test.js\""
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.17.1",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0"
  }
}
